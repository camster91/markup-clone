generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String   @id @default(uuid())
  name       String
  domain     String
  githubRepo String?  // e.g., "camster91/dublin-painters-website"
  apiKey     String?  @unique
  pages      Page[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Page {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([projectId, path])
}

model Comment {
  id            String   @id @default(uuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author        String   @default("Client")
  text          String
  status        String   @default("OPEN")
  
  xPercent      Float
  yPercent      Float
  xpath         String?
  screenSize    String?
  
  proposedCode  String?
  pullRequestUrl String? // Link to the generated GitHub PR

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
