generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String             @id @default(uuid())
  name                String
  domain              String
  apiKey              String             @unique
  // Optional opaque token for the public read-only /share/[token] view.
  // NULL = sharing is disabled for this project. The token is a 32-byte
  // random string, base64url-encoded — generated by the
  // /api/projects/[id]/share POST route and rotated on every call.
  shareToken          String?            @unique
  shareExpiresAt      DateTime?
  sharePasswordHash   String?
  pages               Page[]
  reviewDocuments     ReviewDocument[]
  subscribers         Subscriber[]
  notificationPreferences ProjectNotificationPreference[]
  presences           Presence[]
  // Outbound webhook integrations (Slack / Discord / generic webhook).
  // Cascade: deleting a project removes every configured integration.
  integrations        Integration[]
  integrationEvents   IntegrationEvent[]
  attachments         Attachment[]
  apiTokens           ProjectApiToken[]
  tags                Tag[]
  guestMembers        TeamMember[]       @relation("GuestProjectMembers")
  guestInvitations    TeamInvitation[]   @relation("GuestProjectInvitations")
  reviewRounds        ReviewRound[]      @relation("ProjectReviewRounds")
  activeReviewRoundId String?            @unique
  activeReviewRound   ReviewRound?       @relation("ActiveProjectReviewRound", fields: [activeReviewRoundId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Optional FK to Team. Nullable because the team layer is ADDITIVE —
  // every existing project predates the workspace / team split, and a
  // migration that back-fills teamId for every existing row would
  // silently reassign the whole install to a single team. The /api/projects
  // route's GET filter is "projects whose team is one the caller is a
  // member of"; a NULL teamId is treated as "legacy / unscoped" and
  // visible only when the caller has no teams at all (the transitional
  // single-project dashboard behaviour). Set: Restrict (NOT Cascade) on
  // delete — a Team with active projects must not be silently destroyed.
  teamId              String?
  team                Team?              @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([archivedAt])
}

// The original source for a rendered PDF review. It is deliberately separate
// from Page/Screenshot: pages remain the common review surface, while this row
// retains the opaque source file for audit, recovery, and later download work.
model ReviewDocument {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  mimeType   String
  size       Int
  pageCount  Int
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

// Server-to-server developer credential. The browser-visible Project.apiKey
// remains write-only for widget feedback and must never authorize read APIs.
// Only a SHA-256 hash plus non-secret display fragments are persisted.
model ProjectApiToken {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  tokenLastFour String
  scope       String    @default("issues:read")
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([expiresAt])
  @@index([createdById])
}

// Workspace is the top of the multi-tenant hierarchy (org → teams →
// projects). One Workspace owns one or more Teams; each Team owns zero or
// more Projects. The Workspace row itself has no User FK — workspace
// membership is mediated by Team → TeamMember → User, so a single User
// can belong to multiple teams across multiple workspaces without a
// separate "workspace member" table.
//
// `name` is the org display name (e.g. "Acme Co."). Free-form; the
// dashboard's <WorkspacesList> surfaces it verbatim. The 200-char cap
// matches the project's project-name limit (so a workspace rename
// can't smuggle in a giant string and balloon the dashboard HTML).
model Workspace {
  id              String   @id @default(uuid())
  name            String
  brandName       String?
  logoUrl         String?
  accentColor     String?
  reviewerWelcome String?
  teams           Team[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Team is a sub-group inside a Workspace. A Team owns Projects; the
// /api/projects GET filter is "projects whose team is one the caller
// is a member of". Deleting a Team is `Restrict` (the FK on Project
// refuses the delete) — the dashboard must first move or delete its
// projects. This protects against the "delete the team, lose every
// project" footgun that a Cascade would enable.
model Team {
  id          String       @id @default(uuid())
  // FK to Workspace. Cascade: deleting a workspace removes every
  // team. The reverse is impossible (a team must have a workspace).
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String
  reviewRoundNameTemplate String @default("Review round {n}")
  reviewRoundCommentsPaused Boolean @default(false)
  members     TeamMember[]
  invitations TeamInvitation[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

// TeamMember is a claimed team membership. Legacy pending rows may still have
// userId=NULL; new invitations live in TeamInvitation until acceptance.
// Canonical roles are owner, contributor, client, and guest. Guests carry one
// projectId and can access only that project; all other roles are team-wide.
//
// Email is a denormalized copy of the User's email at the time of
// invite. Storing it on the row means a TeamMember list can be
// rendered even before the userId is back-filled. Cascade: deleting
// the User removes their TeamMember rows (so a user leaving the
// platform doesn't leave ghost memberships behind); deleting the
// Team removes every member. The reverse (User or Team surviving
// independently) is the only meaningful direction.
model TeamMember {
  id        String   @id @default(uuid())
  // FK to Team. Cascade: deleting a team removes every member.
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // FK to User, NULLABLE. The current invite flow inserts a row
  // with userId=null + the email; a follow-up "claimed invite" flow
  // back-fills userId. Cascade: deleting the User removes the
  // member row (so a deleted account doesn't leave stale
  // memberships).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      String   @default("client")
  projectId String?
  project   Project? @relation("GuestProjectMembers", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Denormalized email captured at invite time. Used to render the
  // team-member list before the userId is back-filled.
  email     String
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([userId])
  @@index([projectId])
}

// A bearer-capability invitation. Only tokenHash is persisted; the random
// plaintext token is returned once in a URL fragment so it never enters normal
// HTTP path/referrer logs. Acceptance converts the invitation into TeamMember.
model TeamInvitation {
  id              String    @id @default(uuid())
  teamId          String
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  email           String
  role            String
  tokenHash       String    @unique
  projectId       String?
  project         Project?  @relation("GuestProjectInvitations", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?
  invitedBy       User?     @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teamId, email])
  @@index([projectId])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

// Integration is a per-project outbound notification target. When a new
// pin is created, POST /api/pins records an immutable event and one delivery
// per configured target in the same transaction as the pin. A protected
// worker later delivers each event to Slack, Discord, GitHub, or a generic webhook.
//
// `kind` is a free-form string ('slack' | 'discord' | 'webhook' | 'github') instead
// of a Prisma enum so we can add a new kind in a single edit without a
// migration; the API layer validates against the closed set.
//
// `configJson` is a stringified JSON blob. The shape is kind-specific:
//   - slack:    { webhookUrl: string }
//   - discord:  { webhookUrl: string }
//   - webhook:  { url: string, headers?: Record<string, string> }
//   - github:   { owner: string, repo: string, labels: string[] }
// The route parses + validates the shape per kind, then re-serialises
// before insert. Storing it as a string (vs. a Prisma `Json` column)
// keeps adapter parsing explicit. API responses expose only safe DTOs.
//
// `lastSuccessAt` / `lastError` / `lastErrorAt` track the most recent
// dispatch outcome. The /api/projects/[id]/integrations/test route
// updates these for test pings, and the durable worker updates them
// after delivery attempts. The dashboard's ProjectSettings UI surfaces
// "last success at X" or "last error: Y" so an operator can see at a
// glance which integrations are healthy.
model Integration {
  id            String                @id @default(uuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "slack" | "discord" | "webhook". Free-form so we can add a new
  // kind in a single edit without a migration; the API + adapters
  // enforce the closed set.
  kind          String
  configJson    String
  signingSecret       String?
  credentialCiphertext String?
  lastSuccessAt DateTime?
  lastError     String?
  lastErrorAt   DateTime?
  createdAt     DateTime              @default(now())
  deliveries    IntegrationDelivery[]

  @@index([projectId])
}

// Immutable, versioned event captured in the same transaction as the product
// action that produced it. payloadJson is the exact body delivered to generic
// webhook receivers so signatures are stable across retry attempts.
model IntegrationEvent {
  id          String                @id @default(uuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schema      String                @default("visual-feedback.event.v1")
  type        String
  payloadJson String
  occurredAt  DateTime
  createdAt   DateTime              @default(now())
  deliveries  IntegrationDelivery[]

  @@index([projectId, createdAt])
}

// One durable target delivery for an immutable event. The processor claims due
// rows by status/nextAttemptAt, records an attempt, then succeeds, reschedules,
// or dead-letters the row. lockedAt/lockedBy prevent normal double delivery and
// let a later worker recover a stale process claim.
model IntegrationDelivery {
  id             String                       @id @default(uuid())
  integrationId  String
  integration    Integration                  @relation(fields: [integrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId        String
  event          IntegrationEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status         String                       @default("PENDING")
  attemptCount   Int                          @default(0)
  retryCycle     Int                          @default(0)
  nextAttemptAt  DateTime                     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  deliveredAt    DateTime?
  lastStatusCode Int?
  lastError      String?
  externalId    String?
  externalUrl   String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  attempts       IntegrationDeliveryAttempt[]

  @@unique([integrationId, eventId])
  @@index([status, nextAttemptAt])
  @@index([integrationId, createdAt])
}

// Append-only audit result for a single bounded delivery attempt.
model IntegrationDeliveryAttempt {
  id             String              @id @default(uuid())
  deliveryId     String
  delivery       IntegrationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attemptNumber  Int
  cycle          Int                 @default(0)
  status         String
  startedAt      DateTime
  completedAt    DateTime?
  responseStatus Int?
  error          String?
  durationMs     Int?
  createdAt      DateTime            @default(now())

  @@unique([deliveryId, cycle, attemptNumber])
  @@index([deliveryId, startedAt])
}

model Subscriber {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
}

// Self-service email choices for a registered project member. Legacy external
// Subscriber rows remain separate because they may not correspond to an account.
// The API derives userId from the session and uniquely scopes one row per project.
model ProjectNotificationPreference {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  newPinEmail       Boolean  @default(false)
  newCommentEmail   Boolean  @default(false)
  statusChangeEmail Boolean  @default(false)
  assignmentEmail   Boolean  @default(false)
  mentionEmail      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model Page {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  screenshots Screenshot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, path])
}

model Screenshot {
  id         String              @id @default(uuid())
  pageId     String
  page       Page                @relation(fields: [pageId], references: [id], onDelete: Cascade)
  storageKey String              @unique
  mimeType   String              @default("image/png")
  width      Int
  height     Int
  capturedAt DateTime            @default(now())
  pins       Pin[]
  // Immutable per-recapture history. Every successful recapture
  // appends a new ScreenshotVersion row; the Screenshot row is the
  // "latest pointer" and the ScreenshotVersion rows are the history.
  // The recapture script writes a new PNG to a UUID-based storageKey
  // and inserts the matching version row — the Screenshot's own
  // storageKey is then updated to point at the new file. Old version
  // rows (and their PNGs) are pruned by scripts/prune-screenshots.sh
  // at the same 90-day retention as the parent Screenshot.
  versions   ScreenshotVersion[]
}

// ScreenshotVersion is the immutable per-recapture record. It carries
// its own storageKey (a fresh UUID per version, NOT just screenshot.id)
// so each captured PNG lives at its own path on disk and the
// ScreenshotVersion row is self-contained. The composite index
// (screenshotId, capturedAt) backs the /api/screenshots/[id]/history
// query (last 50 ordered by capturedAt desc) without falling back to
// a sequential scan even when a screenshot has hundreds of versions.
//
// `createdBy` records who triggered the recapture. The current
// recapture script is a fire-and-forget background child, so the
// route writes 'system' today; a future in-process recapture that
// has the operator's userId in hand would write the userId instead
// so an audit UI could surface "Reviewer X triggered 3 recaptures".
model ScreenshotVersion {
  id           String     @id @default(uuid())
  screenshotId String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  capturedAt   DateTime   @default(now())
  width        Int
  height       Int
  storageKey   String     @unique
  createdBy    String

  @@index([screenshotId, capturedAt])
}

model Pin {
  id                     String       @id @default(uuid())
  screenshotId           String
  screenshot             Screenshot   @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  reviewRoundId          String?
  reviewRound            ReviewRound? @relation(fields: [reviewRoundId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  xPercent               Float
  yPercent               Float
  elementXPath           String?
  elementHTML            String?
  // Privacy-bounded environment context captured by the website widget.
  // Nullable so all pins created before this feature remain valid.
  pageUrl                String?
  viewportWidth          Int?
  viewportHeight         Int?
  devicePixelRatio       Float?
  userAgent              String?
  platform               String?
  selectorCandidatesJson String?
  authorName             String       @default("Client")
  status                 String       @default("OPEN")
  priority               String       @default("NONE")
  assigneeId             String?
  assignee               User?        @relation("AssignedPins", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tags                   PinTag[]
  comments               Comment[]
  annotations            Annotation[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([reviewRoundId])
  @@index([assigneeId])
}

// Reusable, project-scoped labels for internal agency issue organization.
// `key` is the normalized, case-insensitive identity; `name` preserves the
// operator's display spelling. The API bounds both values before insert.
model Tag {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name      String
  key       String
  pins      PinTag[]
  createdAt DateTime @default(now())

  @@unique([projectId, key])
  @@index([projectId])
}

// Explicit join keeps pin/tag membership unique and lets either parent cleanly
// cascade without leaving orphaned internal workflow data.
model PinTag {
  pinId String
  pin   Pin    @relation(fields: [pinId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([pinId, tagId])
  @@index([tagId])
}

// A durable agency/client review cycle. Project.activeReviewRoundId selects
// the round receiving new widget pins; historical rounds remain queryable.
model ReviewRound {
  id               String          @id @default(uuid())
  projectId        String
  project          Project         @relation("ProjectReviewRounds", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeForProject Project?        @relation("ActiveProjectReviewRound")
  number           Int
  name             String?
  status           String          @default("DRAFT")
  commentsPaused   Boolean         @default(false)
  createdBy        String
  pins             Pin[]
  signOffs         ReviewSignOff[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

// An attributable reviewer approval. signerEmail preserves the audit label if
// the optional User relation is later removed; public share tokens never sign.
model ReviewSignOff {
  id            String      @id @default(uuid())
  reviewRoundId String
  reviewRound   ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  signerEmail   String
  note          String?
  createdAt     DateTime    @default(now())

  @@unique([reviewRoundId, userId])
  @@index([userId])
}

// Annotation is a free-form drawing (arrow / box / freehand) drawn on top
// of the screenshot. Coordinates are stored as JSON in `pathJson` so the
// shape stays opaque to the DB and we can extend it per kind without a
// schema change.
//
// Shape conventions (enforced in the widget, validated in the API):
//   - arrow:     [[x1, y1], [x2, y2]]                   (start, end)
//   - box:       [[x1, y1], [x2, y2]]                   (top-left, bottom-right)
//   - freehand:  [[x1, y1], [x2, y2], ...]              (polyline, ≥ 2 points)
//
// All coords are in the screenshot's PIXEL space, NOT the viewport's. The
// widget converts viewport-px to image-px by scaling clickX/clickY against
// (screenshot.width / window.innerWidth). The dashboard's ScreenshotView
// then converts image-px → percentage (×100 / image natural size) and
// renders the SVG overlay sized to the <img>'s box. This decouples the
// drawing from the dashboard's CSS layout, so the same annotation renders
// at the right spot on any container width.
//
// Annotations are stored on the Pin (not the Screenshot) so the same
// screenshot can have multiple pins with completely different drawings
// overlapping without confusion — and deleting a pin removes its marks.
model Annotation {
  id        String   @id @default(uuid())
  pinId     String
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  // "arrow" | "box" | "freehand". Free-form string instead of a Prisma enum
  // so we can add a new kind in a single edit without a migration; the
  // API layer validates the value against the closed set.
  kind      String
  pathJson  String
  createdAt DateTime @default(now())

  @@index([pinId])
}

model Comment {
  id          String       @id @default(uuid())
  pinId       String
  pin         Pin          @relation(fields: [pinId], references: [id], onDelete: Cascade)
  author      String       @default("Client")
  authorRole  String       @default("client")
  text        String
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Attachment is a file (image, voice, video) attached to a Comment. The
// first surface is screenshots pasted from the dashboard reviewer's
// clipboard, but the schema reserves `kind` ('image' | 'voice' |
// 'video') so a follow-up feature can add voice notes / video replies
// without a schema migration. The API layer (POST /api/attachments)
// currently rejects anything that isn't 'image'.
//
// storageKey is the on-disk filename under ATTACHMENTS_DIR (a
// bind-mount at /data/attachments in production, the same path style
// the screenshot route uses). It's a UUID + extension so two writes
// can't collide and so a path-traversal probe in the GET route is
// confined to single-segment filenames.
//
// Cascade: deleting the parent Comment removes its attachments. The
// Comment → Pin → Screenshot → Page chain keeps the rest of the
// cascade clean (a deleted project removes every page, every
// screenshot, every pin, every comment, and every attachment).
model Attachment {
  id         String   @id @default(uuid())
  // FK to Comment. Nullable so an upload can land in the DB
  // BEFORE its parent comment is created — the dashboard's
  // paste handler POSTs the attachment, gets back an id, then
  // POSTs the comment with the matching attachmentIds in the
  // same batch. The Comment.create route uses
  // `connect: [{ id }]` to bind orphan attachments to the new
  // comment. Cascade: deleting a Comment removes its
  // attachments (the rows that have a non-null commentId).
  // Orphan rows (commentId IS NULL) are not cascade-deleted
  // by a Comment deletion; a separate prune job could
  // garbage-collect them, but in practice the dashboard
  // uploads-then-creates atomically so orphans shouldn't
  // accumulate.
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Owning project is recorded at upload time so an unbound attachment
  // cannot be claimed by a comment in another project. Nullable only for
  // backwards compatibility with pre-migration orphan rows.
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // "image" | "voice" | "video". Free-form string instead of a
  // Prisma enum so we can add a new kind in a single edit without
  // a migration; the API layer validates the value against the
  // closed set before insert.
  kind       String
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([commentId])
  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
  @@index([action])
}

// Presence tracks a dashboard reviewer's "I'm looking at this project" heartbeat.
// The `userId` is generated client-side and stored in localStorage — F10 will
// replace it with a real authenticated User id. One row per (userId, projectId);
// the row's `lastSeenAt` is bumped on every heartbeat, so a 60s TTL filters out
// disconnected reviewers from the "online" list.
model Presence {
  id           String   @id @default(cuid())
  userId       String
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screenshotId String?
  lastSeenAt   DateTime @default(now())
  cursorX      Float?
  cursorY      Float?

  @@unique([userId, projectId])
  @@index([projectId, lastSeenAt])
}

// User is a dashboard identity. Email + password is the login credential.
// Roles are "operator" (full dashboard access, can create projects) and
// "reviewer" (read + comment access). The role is a free-form string
// (not a Prisma enum) so adding a new role doesn't require a migration;
// the API layer enforces membership in the closed set.
model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  // "operator" | "reviewer". Free-form so we can add a new role in a
  // single edit without a migration; the API + UI enforce the closed set.
  role           String          @default("reviewer")
  createdAt      DateTime        @default(now())
  sessions       Session[]
  // Back-relation to TeamMember. Optional (a User can exist without any
  // team memberships — e.g. before they're invited to a team). Cascade
  // on the TeamMember side removes the rows when the User is deleted;
  // a User without a team simply has an empty array.
  teamMembers    TeamMember[]
  invitationsSent TeamInvitation[] @relation("InvitationsSent")
  reviewSignOffs ReviewSignOff[]
  assignedPins   Pin[]           @relation("AssignedPins")
  createdApiTokens ProjectApiToken[]
  notificationPreferences ProjectNotificationPreference[]
}

// Session is a server-issued login token. The browser stores the token
// in an HttpOnly cookie; the row is the server's source of truth. The
// `token` is a 64-char base64url random string (32 bytes of entropy);
// the unique index backs a uniqueness guarantee on every issued token
// (1 - 2^-256 collision probability per issuance). The 7-day expiry
// matches the cookie's maxAge — a session row is the same lifetime as
// the cookie that holds it.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
