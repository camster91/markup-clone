generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  domain      String
  apiKey      String       @unique
  // Optional opaque token for the public read-only /share/[token] view.
  // NULL = sharing is disabled for this project. The token is a 32-byte
  // random string, base64url-encoded — generated by the
  // /api/projects/[id]/share POST route and rotated on every call.
  shareToken  String?      @unique
  pages       Page[]
  subscribers Subscriber[]
  presences   Presence[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Subscriber {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
}

model Page {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  screenshots Screenshot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, path])
}

model Screenshot {
  id         String   @id @default(uuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  width      Int
  height     Int
  capturedAt DateTime @default(now())
  pins       Pin[]
}

model Pin {
  id           String    @id @default(uuid())
  screenshotId String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  xPercent     Float
  yPercent     Float
  elementXPath String?
  elementHTML  String?
  authorName   String    @default("Client")
  status       String    @default("OPEN")
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Comment {
  id         String   @id @default(uuid())
  pinId      String
  pin        Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  author     String   @default("Client")
  authorRole String   @default("client")
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
  @@index([action])
}

// Presence tracks a dashboard reviewer's "I'm looking at this project" heartbeat.
// The `userId` is generated client-side and stored in localStorage — F10 will
// replace it with a real authenticated User id. One row per (userId, projectId);
// the row's `lastSeenAt` is bumped on every heartbeat, so a 60s TTL filters out
// disconnected reviewers from the "online" list.
model Presence {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screenshotId String?
  lastSeenAt  DateTime @default(now())
  cursorX     Float?
  cursorY     Float?

  @@unique([userId, projectId])
  @@index([projectId, lastSeenAt])
}
