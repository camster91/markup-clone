generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  domain    String   // e.g., "ashbi.ca"
  pages     Page[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String    // e.g., "/about"
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([projectId, path])
}

model Comment {
  id            String   @id @default(uuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author        String   @default("Client")
  text          String
  status        String   @default("OPEN") // OPEN, RESOLVED
  
  // DOM anchoring
  xPercent      Float    // X coordinate as % of screen width
  yPercent      Float    // Y coordinate as % of screen height
  xpath         String?  // Exact DOM element selector
  screenSize    String?  // e.g., "1920x1080" (to help recreate the layout)
  
  // Agentic Action
  proposedCode  String?  // If the AI agent writes a fix, store it here

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
