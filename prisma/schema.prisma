generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  domain      String
  apiKey      String       @unique
  // Optional opaque token for the public read-only /share/[token] view.
  // NULL = sharing is disabled for this project. The token is a 32-byte
  // random string, base64url-encoded — generated by the
  // /api/projects/[id]/share POST route and rotated on every call.
  shareToken  String?      @unique
  pages       Page[]
  subscribers Subscriber[]
  presences   Presence[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Subscriber {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
}

model Page {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path        String
  screenshots Screenshot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, path])
}

model Screenshot {
  id         String   @id @default(uuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  width      Int
  height     Int
  capturedAt DateTime @default(now())
  pins       Pin[]
  // Immutable per-recapture history. Every successful recapture
  // appends a new ScreenshotVersion row; the Screenshot row is the
  // "latest pointer" and the ScreenshotVersion rows are the history.
  // The recapture script writes a new PNG to a UUID-based storageKey
  // and inserts the matching version row — the Screenshot's own
  // storageKey is then updated to point at the new file. Old version
  // rows (and their PNGs) are pruned by scripts/prune-screenshots.sh
  // at the same 90-day retention as the parent Screenshot.
  versions   ScreenshotVersion[]
}

// ScreenshotVersion is the immutable per-recapture record. It carries
// its own storageKey (a fresh UUID per version, NOT just screenshot.id)
// so each captured PNG lives at its own path on disk and the
// ScreenshotVersion row is self-contained. The composite index
// (screenshotId, capturedAt) backs the /api/screenshots/[id]/history
// query (last 50 ordered by capturedAt desc) without falling back to
// a sequential scan even when a screenshot has hundreds of versions.
//
// `createdBy` records who triggered the recapture. The current
// recapture script is a fire-and-forget background child, so the
// route writes 'system' today; a future in-process recapture that
// has the operator's userId in hand would write the userId instead
// so an audit UI could surface "Reviewer X triggered 3 recaptures".
model ScreenshotVersion {
  id          String     @id @default(uuid())
  screenshotId String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  capturedAt   DateTime   @default(now())
  width        Int
  height       Int
  storageKey   String     @unique
  createdBy    String

  @@index([screenshotId, capturedAt])
}

model Pin {
  id           String       @id @default(uuid())
  screenshotId String
  screenshot   Screenshot  @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  xPercent     Float
  yPercent     Float
  elementXPath String?
  elementHTML  String?
  authorName   String       @default("Client")
  status       String       @default("OPEN")
  comments     Comment[]
  annotations  Annotation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Annotation is a free-form drawing (arrow / box / freehand) drawn on top
// of the screenshot. Coordinates are stored as JSON in `pathJson` so the
// shape stays opaque to the DB and we can extend it per kind without a
// schema change.
//
// Shape conventions (enforced in the widget, validated in the API):
//   - arrow:     [[x1, y1], [x2, y2]]                   (start, end)
//   - box:       [[x1, y1], [x2, y2]]                   (top-left, bottom-right)
//   - freehand:  [[x1, y1], [x2, y2], ...]              (polyline, ≥ 2 points)
//
// All coords are in the screenshot's PIXEL space, NOT the viewport's. The
// widget converts viewport-px to image-px by scaling clickX/clickY against
// (screenshot.width / window.innerWidth). The dashboard's ScreenshotView
// then converts image-px → percentage (×100 / image natural size) and
// renders the SVG overlay sized to the <img>'s box. This decouples the
// drawing from the dashboard's CSS layout, so the same annotation renders
// at the right spot on any container width.
//
// Annotations are stored on the Pin (not the Screenshot) so the same
// screenshot can have multiple pins with completely different drawings
// overlapping without confusion — and deleting a pin removes its marks.
model Annotation {
  id        String   @id @default(uuid())
  pinId     String
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  // "arrow" | "box" | "freehand". Free-form string instead of a Prisma enum
  // so we can add a new kind in a single edit without a migration; the
  // API layer validates the value against the closed set.
  kind      String
  pathJson  String
  createdAt DateTime @default(now())

  @@index([pinId])
}

model Comment {
  id         String   @id @default(uuid())
  pinId      String
  pin        Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  author     String   @default("Client")
  authorRole String   @default("client")
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actor])
  @@index([action])
}

// Presence tracks a dashboard reviewer's "I'm looking at this project" heartbeat.
// The `userId` is generated client-side and stored in localStorage — F10 will
// replace it with a real authenticated User id. One row per (userId, projectId);
// the row's `lastSeenAt` is bumped on every heartbeat, so a 60s TTL filters out
// disconnected reviewers from the "online" list.
model Presence {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screenshotId String?
  lastSeenAt  DateTime @default(now())
  cursorX     Float?
  cursorY     Float?

  @@unique([userId, projectId])
  @@index([projectId, lastSeenAt])
}

// User is a dashboard identity. Email + password is the login credential.
// Roles are "operator" (full dashboard access, can create projects) and
// "reviewer" (read + comment access). The role is a free-form string
// (not a Prisma enum) so adding a new role doesn't require a migration;
// the API layer enforces membership in the closed set.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  // "operator" | "reviewer". Free-form so we can add a new role in a
  // single edit without a migration; the API + UI enforce the closed set.
  role         String   @default("reviewer")
  createdAt    DateTime @default(now())
  sessions     Session[]
}

// Session is a server-issued login token. The browser stores the token
// in an HttpOnly cookie; the row is the server's source of truth. The
// `token` is a 64-char base64url random string (32 bytes of entropy);
// the unique index backs a uniqueness guarantee on every issued token
// (1 - 2^-256 collision probability per issuance). The 7-day expiry
// matches the cookie's maxAge — a session row is the same lifetime as
// the cookie that holds it.
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
