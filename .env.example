# markup-clone environment variables
# =================================
#
# Copy to .env (locally) or /root/markup-clone/.env (on the VPS) and fill in
# the values. All values here are PLACEHOLDERS — never commit a real .env.
#
# Two consumption paths read this file:
#
#   1. Next.js / Prisma runtime (process.env.*). On the VPS, deploy.sh
#      passes the file to the container via --env-file (see
#      scripts/deploy.sh). On macOS, docker-compose.yml's app service
#      reads it through the host shell's `set -a; source .env` flow.
#
#   2. The Prisma CLI (prisma generate, prisma migrate) reads
#      DATABASE_URL at build time via the `url = env("DATABASE_URL")`
#      line in prisma/schema.prisma. A build-time placeholder is fine;
#      the real connection is opened at runtime.
#
# IMPORTANT: secrets in this file should NEVER be pasted into a
# `terminal` tool call. The chat layer mangles credential-shaped
# patterns (`user:***@host:5432/db`, heredocs with `$(...)`, etc).
# See the "Deploying secrets to the VPS" section of the README and
# the chat-layer-redaction-workarounds skill for the verified
# `write_file` → `cat .env | ssh` flow.

# ── Required ────────────────────────────────────────────────────────

# PostgreSQL connection string. Prisma opens this on app start.
# Local dev: postgresql://markup:***@localhost:5432/markup_db
# Production: postgresql://markup:***@markup-postgres:5432/markup_db
DATABASE_URL="postgresql://markup:***@markup-postgres:5432/markup_db"

# Runtime environment. Set to "production" in deploy.sh (Dockerfile
# runner layer also pins it). The Prisma client uses this to decide
# whether to cache the singleton on globalThis (dev hot-reload).
NODE_ENV="production"

# Public hostname clients hit (used by requireDashboardOrigin in
# src/lib/auth.ts and the dashboard "view" link in src/lib/email.ts).
# Default if unset: markup.ashbi.ca
#
# Both of the following forms are accepted (see src/lib/origin.ts for the
# unified parser). The bare-hostname form is the canonical one — it keeps
# the value copy-pasteable between the server and client env (which both
# read the same string) and avoids the risk of a stray trailing slash.
#
#   DASHBOARD_HOST="markup.ashbi.ca"            # canonical (preferred)
#   DASHBOARD_HOST="https://markup.ashbi.ca"    # also accepted
#
# If you need a non-default port (e.g. local dev on :3000), use the
# full-URL form and the parser will preserve it on the Origin side while
# matching on the bare hostname for the allow-list.
DASHBOARD_HOST="markup.ashbi.ca"

# Absolute path inside the container where screenshot PNGs are
# persisted. The deploy script bind-mounts /data/screenshots on the
# host to this path. Three route handlers read it (image, pins
# [GET/POST], projects/[id]).
SCREENSHOTS_DIR="/data/screenshots"

# ── Mailgun (subscriber notifications) ─────────────────────────────

# Mailgun HTTP API key. src/lib/email.ts sends fire-and-forget
# notifications to project subscribers when new comments land. If
# either of these is empty, the email path is a no-op (logged at
# debug level) — the rest of the app keeps working.
MAILGUN_API_KEY=""

# Mailgun-verified sending domain (e.g. mg.ashbi.ca). Used in both
# the From address (`feedback@${MAILGUN_DOMAIN}`) and the API path
# (https://api.mailgun.net/v3/${MAILGUN_DOMAIN}/messages).
MAILGUN_DOMAIN=""

# ── Optional / override paths ──────────────────────────────────────

# Override the path the recapture route shells out to. The default
# (/opt/app-scripts/recapture.sh) is the bind-mount target that
# deploy.sh wires up from /root/markup-clone/scripts. Set this only
# in non-standard deploys (custom mount, sidecar, etc).
RECAPTURE_SCRIPT="/opt/app-scripts/recapture.sh"

# ── Deploy script knobs (consumed by bash, not Node) ───────────────
# These live in the same .env so operators only have one file to
# track on the VPS. deploy.sh and markup-caddy-guard.sh read them
# via the same --env-file path. None of these need to be set in
# dev; the scripts have sane defaults.

# Port the app container binds on 127.0.0.1. Caddy reverse-proxies
# to this. Default: 3030.
HOST_PORT="3030"

# Public hostname the deploy script adds a Caddy route for.
# Default: markup.ashbi.ca.
PUBLIC_HOSTNAME="markup.ashbi.ca"
