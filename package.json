{
  "name": "markup-clone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:core && next build",
    "build:core": "cd packages/markup-core && ./build.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "bash tests/smoke.sh",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "build:widget": "vite build",
    "prebuild": "npm run build:widget"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@markup/core": "file:./packages/markup-core",
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.4.5",
    "next": "16.2.9",
    "prisma": "^6.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.5"
  }
}
