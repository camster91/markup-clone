{
  "name": "markup-clone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:packages && next build",
    "build:core": "node scripts/build-core.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:packages": "npm run build:core && npm run build:sdk",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "bash tests/smoke.sh",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:load:local": "node scripts/run-local-pin-load.mjs",
    "verify:public-release": "node scripts/verify-public-release.cjs --origin https://markup.ashbi.ca",
    "build:widget": "vite build",
    "prebuild": "npm run build:widget"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@markup/core": "file:./packages/markup-core",
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.4.5",
    "next": "^16.4.1",
    "prisma": "^6.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
  }
}
